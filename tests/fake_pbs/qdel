#!/bin/bash
# A fake PBS qdel for the tests, deleting the jobs of the fake qsub next to it.
#
# Usage: qdel JOB_ID... Each call is logged to $FAKE_PBS_DIR/qdel.log (cwd,
# then the arguments, tab-separated). Jobs are found by number, as by the fake
# qstat. As the fake qsub runs every job before returning, only held jobs can
# be deleted: their entry for the fake qstat becomes a finished job deleted
# before it started (job_state F, substate 91, no Exit_status; for an array,
# no elements). For the other jobs, it prints PBS's error messages to stderr
# and exits with PBS's status (153 for an unknown job, 35 for a finished one;
# the last error wins).
set -eu

: "${FAKE_PBS_DIR:?FAKE_PBS_DIR is not set}"
mkdir -p "$FAKE_PBS_DIR"
(IFS=$'\t'; printf '%s\t%s\n' "$PWD" "$*") >>"$FAKE_PBS_DIR/qdel.log"

if [ $# -eq 0 ]; then
    echo "qdel (fake): expected JOB_ID..." >&2
    exit 2
fi

status=0
for id; do
    entry="$FAKE_PBS_DIR/jobs/${id%%[.[]*}.qstat"
    if [ ! -f "$entry" ]; then
        echo "qdel: Unknown Job Id $id" >&2
        status=153
    elif grep -q '"job_state":"F"' "$entry"; then
        echo "qdel: Job has finished $id" >&2
        status=35
    else
        sed -e 's/"job_state":"H","Hold_Types":"u"/"job_state":"F","substate":91/' \
            -e 's/"job_state":"H"/"job_state":"F","substate":91/' \
            -e 's/Queued:\([0-9]*\) /Queued:0 /' "$entry" >"$entry.new"
        mv "$entry.new" "$entry"
    fi
done
exit "$status"
